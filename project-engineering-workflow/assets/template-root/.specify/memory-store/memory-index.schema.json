{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Memory Index",
  "type": "object",
  "required": ["schema", "version", "entries"],
  "properties": {
    "schema": { "type": "string" },
    "version": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scope", "type", "summary", "path", "updated_at", "status"],
        "properties": {
          "id": { "type": "string" },
          "scope": { "type": "string" },
          "owner_id": { "type": ["string", "null"] },
          "data_role": { "type": ["string", "null"] },
          "type": { "type": "string" },
          "summary": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "path": { "type": "string" },
          "updated_at": { "type": "string" },
          "expires_at": { "type": ["string", "null"] },
          "status": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
