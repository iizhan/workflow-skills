{
  "name": "skill-management-workbench",
  "version": "0.0.1",
  "private": true,
  "author": "Skill OS",
  "description": "Local-first skill registry, telemetry, analytics, and optimization workbench.",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "sync:workflow-assets": "node scripts/sync-workflow-assets.mjs",
    "verify:workflow-assets": "node scripts/verify-workflow-assets.mjs",
    "test:workflow-assets": "npm run sync:workflow-assets && npm run verify:workflow-assets && node scripts/workflow-asset-paths-integration.mjs",
    "build": "npm run sync:workflow-assets && npm run verify:workflow-assets && electron-vite build",
    "verify:package:dir": "node scripts/verify-packaged-workflow-assets.mjs --app-dir \"release/mac-arm64/Skill OS.app\"",
    "package:dir": "npm run build && electron-builder --mac --arm64 --dir && npm run verify:package:dir",
    "package:mac": "npm run build && electron-builder --mac --arm64",
    "preview": "electron-vite preview",
    "smoke": "node scripts/smoke-check.mjs",
    "test:starter": "node scripts/workflow-starter-integration.mjs",
    "test:workflow-registry": "esbuild scripts/workflow-registry-integration.ts --bundle --platform=node --format=esm --outfile=tmp/workflow-registry-integration.mjs --external:better-sqlite3 --external:esbuild && ELECTRON_RUN_AS_NODE=1 electron tmp/workflow-registry-integration.mjs",
    "test:scenario-loop": "ELECTRON_RUN_AS_NODE=1 electron scripts/scenario-loop-integration.mjs",
    "test:trace": "esbuild scripts/trace-service-integration.ts --bundle --platform=node --format=esm --outfile=tmp/trace-service-integration.mjs --external:better-sqlite3 && ELECTRON_RUN_AS_NODE=1 electron tmp/trace-service-integration.mjs",
    "test:registry-scan": "esbuild scripts/registry-scan-integration.ts --bundle --platform=node --format=esm --outfile=tmp/registry-scan-integration.mjs --external:better-sqlite3 --external:yaml && ELECTRON_RUN_AS_NODE=1 electron tmp/registry-scan-integration.mjs",
    "test:harness-events": "esbuild scripts/harness-event-integration.ts --bundle --platform=node --format=esm --outfile=tmp/harness-event-integration.mjs --external:better-sqlite3 && ELECTRON_RUN_AS_NODE=1 electron tmp/harness-event-integration.mjs",
    "test:adapter-readiness": "esbuild scripts/adapter-readiness-integration.ts --bundle --platform=node --format=esm --outfile=tmp/adapter-readiness-integration.mjs --external:better-sqlite3 && ELECTRON_RUN_AS_NODE=1 electron tmp/adapter-readiness-integration.mjs",
    "test:app-server-observation": "esbuild scripts/codex-app-server-observation-integration.ts --bundle --platform=node --format=esm --outfile=tmp/codex-app-server-observation-integration.mjs --external:better-sqlite3 && ELECTRON_RUN_AS_NODE=1 electron tmp/codex-app-server-observation-integration.mjs",
    "test:model-evaluation": "esbuild scripts/model-evaluation-integration.ts --bundle --platform=node --format=esm --outfile=tmp/model-evaluation-integration.mjs --external:better-sqlite3 && ELECTRON_RUN_AS_NODE=1 electron tmp/model-evaluation-integration.mjs",
    "test:integration": "npm run test:workflow-registry && npm run test:registry-scan && npm run test:scenario-loop && npm run test:trace && npm run test:harness-events && npm run test:adapter-readiness && npm run test:app-server-observation && npm run test:model-evaluation",
    "layout:check": "node scripts/layout-check.mjs",
    "self-test:ui": "SKILL_OS_SELF_TEST_REQUIRE_BROWSER=1 node scripts/self-test-ui.mjs",
    "self-test:ui:chrome": "SKILL_OS_SELF_TEST_REQUIRE_BROWSER=1 SKILL_OS_SELF_TEST_RUNTIME=chrome node scripts/self-test-ui.mjs",
    "self-test:ui:source": "SKILL_OS_SELF_TEST_SOURCE_ONLY=1 node scripts/self-test-ui.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.29",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.21.5",
    "electron": "^31.7.7",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  },
  "build": {
    "appId": "com.workflow-skills.skill-os",
    "productName": "Skill OS",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/project-engineering-workflow",
        "to": "project-engineering-workflow"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
